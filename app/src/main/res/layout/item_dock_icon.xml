<?xml version="1.0" encoding="utf-8"?>
<!-- Ячейка дока: иконка + подпись + бейдж уведомлений + подсветка цели перетаскивания -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dockCellRoot"
    android:layout_width="58dp"
    android:layout_height="66dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Подсветка слота при перетаскивании иконки из сетки -->
    <View
        android:id="@+id/dockDropTarget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_folder_drop_target"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/dockIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/dockBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_drag_badge"
                android:elevation="4dp"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/dockLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

    </LinearLayout>

</FrameLayout>