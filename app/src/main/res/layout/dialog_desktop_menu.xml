<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_drawer_background"
   
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/glass_search_background" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Рабочий стол Morphix"
        android:textColor="#FFFFFF"
       
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:text="Настройка интерфейса и пространств"
        android:textColor="#80FFFFFF"
       
        android:textSize="12sp" />

    <!-- Настройки Morphix -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMenuSettings"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical|start"
        android:text="⚙️ Настройки Morphix"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:cornerRadius="26dp" />

    <!-- Добавить системный виджет -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMenuAddWidget"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical|start"
        android:text="➕ Добавить системный виджет"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:cornerRadius="26dp" />

    <!-- Переключить пространство -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMenuSwitchSpace"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical|start"
        android:text="👥 Перейти во Второе пространство"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:cornerRadius="26dp" />

    <!-- Приложения для Второго пространства -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMenuSecondSpaceApps"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical|start"
        android:text="➕ Приложения для 2-го пространства"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone"
        app:cornerRadius="26dp" />

    <!-- Сменить обои -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMenuWallpaper"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical|start"
        android:text="🖼️ Сменить обои"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:cornerRadius="26dp" />

    <!-- Режим стола -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMenuLayoutMode"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical|start"
        android:text="📱 Переключить режим стола"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:cornerRadius="26dp" />

</LinearLayout>




