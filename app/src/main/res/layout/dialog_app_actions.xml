<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_drawer_background"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/glass_search_background" />

    <!-- Шапка приложения: Иконка и Название -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/actionAppIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            tools:src="@drawable/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/actionAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Telegram" />

            <TextView
                android:id="@+id/actionAppPackage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                tools:text="org.telegram.messenger" />
        </LinearLayout>
    </LinearLayout>

    <!-- Добавить/убрать с рабочего стола -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnActionToggleHome"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical|start"
        android:text="📌 Добавить на рабочий стол"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:cornerRadius="25dp" />

    <!-- О приложении -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnActionAppInfo"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical|start"
        android:text="ℹ️ О приложении"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:cornerRadius="25dp" />

    <!-- Скрыть в Vault -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnActionHideVault"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical|start"
        android:text="🔒 Скрыть в защищенное хранилище"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:cornerRadius="25dp" />

    <!-- Удалить приложение -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnActionUninstall"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="#33FF5252"
        android:gravity="center_vertical|start"
        android:text="🗑️ Удалить приложение"
        android:textColor="#FF5252"
        android:textSize="14sp"
        app:cornerRadius="25dp"
        app:strokeColor="#66FF5252"
        app:strokeWidth="1dp" />

</LinearLayout>





