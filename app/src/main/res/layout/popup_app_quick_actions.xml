<?xml version="1.0" encoding="utf-8"?>
<com.naua_morphix_launcher.app.views.LiquidGlassView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="210dp"
    android:layout_height="wrap_content"
    android:elevation="12dp"
    app:lg_cornerRadius="16dp" app:lg_overlayColor="#A6121216" app:lg_fallbackColor="#E6121216">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="8dp"
    android:paddingEnd="6dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvPopupAppTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Telegram" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:background="#26FFFFFF" />

    <TextView
        android:id="@+id/btnPopupToggleHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:drawablePadding="12dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:text="Убрать с экрана"
        android:textColor="#FFFFFF"
        android:textSize="13.5sp" />

    <TextView
        android:id="@+id/btnPopupMoveToPage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:drawablePadding="12dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:text="На другой экран"
        android:textColor="#FFFFFF"
        android:textSize="13.5sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnPopupFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:drawablePadding="12dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:text="В папку"
        android:textColor="#FFFFFF"
        android:textSize="13.5sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnPopupSecondSpace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:drawablePadding="12dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:text="Копия для 2-го"
        android:textColor="#FFFFFF"
        android:textSize="13.5sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnPopupAppInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        
        android:drawablePadding="12dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:text="О приложении"
        android:textColor="#FFFFFF"
        android:textSize="13.5sp" />

    <TextView
        android:id="@+id/btnPopupHideVault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        
        android:drawablePadding="12dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:text="Скрыть в Vault"
        android:textColor="#FFFFFF"
        android:textSize="13.5sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:background="#1AFFFFFF" />

    <TextView
        android:id="@+id/btnPopupUninstall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        
        android:drawablePadding="12dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:text="Удалить"
        android:textColor="#FF6B6B"
        android:textSize="13.5sp" />

</LinearLayout>

</com.naua_morphix_launcher.app.views.LiquidGlassView>
