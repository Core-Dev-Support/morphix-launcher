<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clockWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="6dp">

    <!-- Левая колонка: Время и дата -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/textClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:textColor="#FFFFFF"
            android:textSize="46sp"
            android:textStyle="bold"
            tools:text="15:18" />

        <TextClock
            android:id="@+id/textDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2dp"
            android:format12Hour="EEE, d MMMM"
            android:format24Hour="EEE, d MMMM"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="#F0FFFFFF"
            android:textSize="15sp"
            tools:text="Сб, 5 Сентября" />
    </LinearLayout>

    <!-- Правая колонка: Иконка погоды и статус -->
    <LinearLayout
        android:id="@+id/weatherWidgetContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivWeatherIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_weather_xiaomi" />

        <TextView
            android:id="@+id/tvWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="Данных нет"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp"
            tools:text="Данных нет" />
    </LinearLayout>

</LinearLayout>



