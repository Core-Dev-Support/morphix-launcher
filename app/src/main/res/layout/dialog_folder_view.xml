<?xml version="1.0" encoding="utf-8"?>
<com.naua_morphix_launcher.app.views.LiquidGlassView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/glassSettingsRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="24dp"
    app:lg_cornerRadius="28dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Заголовок папки (нажмите, чтобы переименовать) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etFolderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="center"
            android:hint="Название папки"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:maxLength="24"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#80FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Инструменты" />

        <ImageView
            android:id="@+id/ivRenameHint"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:alpha="0.6"
            android:contentDescription="Переименовать"
            android:src="@drawable/ic_edit_xiaomi"
            app:tint="#FFFFFF" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:text="Нажмите на имя, чтобы переименовать"
        android:textColor="#80FFFFFF"
        android:textSize="11sp" />

    <!-- Сетка приложений внутри папки -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFolderApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:maxHeight="360dp"
        android:overScrollMode="never"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <!-- Нижняя панель действий: Добавить приложение / Готово -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddAppToFolder"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:backgroundTint="#2EFFFFFF"
            android:text="➕ Добавить"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:cornerRadius="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFolderDone"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#3B82F6"
            android:text="Готово"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:cornerRadius="20dp" />

    </LinearLayout>

</LinearLayout>

</com.naua_morphix_launcher.app.views.LiquidGlassView>
